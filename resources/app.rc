#pragma code_page(65001)
#include <windows.h>

#define IDI_BLUE 101
#define IDI_RED 102
#define IDD_SETTINGS 201

#define IDC_ACCOUNT 1001
#define IDC_PASSWORD 1002
#define IDC_PROVIDER 1003
#define IDC_INTERVAL 1004
#define IDC_COOLDOWN 1005
#define IDC_FALLBACK 1006
#define IDC_AUTOSTART 1007
#define IDC_NOTIFY_SUCCESS 1008
#define IDC_NOTIFY_FAILURE 1019
#define IDC_LAST_LOGIN 1009
#define IDC_STATUS 1010
#define IDC_CLEAR_DATA 1011
#define IDC_INTERVAL_SPIN 1013
#define IDC_COOLDOWN_SPIN 1014
#define IDC_SECURITY_NOTICE 1015
#define IDC_COOLDOWN_FRAME 1027
#define IDC_LOGIN_ONCE 1016
#define IDC_GITHUB 1018

IDI_BLUE ICON "resources/assets/campus-blue.ico"
IDI_RED ICON "resources/assets/campus-red.ico"
1 RT_MANIFEST "resources/app.manifest"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "南湖校园网自动登录项目\0"
            VALUE "FileDescription", "南湖校园网自动登录\0"
            VALUE "FileVersion", "2.0.0.0\0"
            VALUE "InternalName", "CampusNetAutoLogin\0"
            VALUE "OriginalFilename", "CampusNetAutoLogin.exe\0"
            VALUE "ProductName", "南湖校园网自动登录\0"
            VALUE "ProductVersion", "2.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 360, 304
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "校园网自动登录设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "学号或账号", -1, 10, 14, 74, 12
    EDITTEXT        IDC_ACCOUNT, 88, 12, 185, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "GitHub", IDC_GITHUB, 304, 12, 46, 16

    LTEXT           "密码", -1, 10, 35, 74, 12
    EDITTEXT        IDC_PASSWORD, 88, 33, 185, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "服务商", -1, 10, 56, 74, 12
    COMBOBOX        IDC_PROVIDER, 88, 54, 82, 82, CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "", IDC_COOLDOWN_FRAME, "Static", SS_OWNERDRAW | WS_CLIPSIBLINGS, 84, 71, 232, 44

    LTEXT           "检测间隔（秒）", -1, 10, 77, 74, 12
    EDITTEXT        IDC_INTERVAL, 88, 75, 82, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "", IDC_INTERVAL_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 157, 75, 13, 16
    LTEXT           "失败三次冷却翻倍，CD上限为检测间隔", -1, 180, 77, 128, 12

    LTEXT           "失败冷却（秒）", -1, 10, 98, 74, 12
    EDITTEXT        IDC_COOLDOWN, 88, 96, 82, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "", IDC_COOLDOWN_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS, 157, 96, 13, 16
    LTEXT           "-1：失败后暂停自动重连；0：不额外冷却", -1, 180, 98, 128, 12

    LTEXT           "国内备用探测", -1, 10, 119, 74, 12
    EDITTEXT        IDC_FALLBACK, 88, 117, 230, 16, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "开机自启", -1, 10, 143, 74, 12
    CONTROL         "用户登录 Windows 后自动启动", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 139, 262, 16
    CONTROL         "仅开机自启时自动登录一次（不再自动检测/重试）", IDC_LOGIN_ONCE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 159, 262, 16

    LTEXT           "通知", -1, 10, 185, 74, 12
    CONTROL         "显示成功通知", IDC_NOTIFY_SUCCESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 181, 100, 16
    CONTROL         "显示失败通知", IDC_NOTIFY_FAILURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 208, 181, 100, 16

    LTEXT           "最近成功登录", -1, 10, 201, 68, 12
    LTEXT           "暂无", IDC_LAST_LOGIN, 88, 201, 262, 12, SS_LEFTNOWORDWRAP
    LTEXT           "当前网络状态", -1, 10, 220, 72, 12
    LTEXT           "等待检测", IDC_STATUS, 88, 220, 262, 18, SS_LEFT

    LTEXT           "密码使用 Windows 当前用户身份加密保存；校园网认证接口为 HTTP。", IDC_SECURITY_NOTICE, 10, 240, 340, 12, SS_LEFT
    LTEXT           "保存后软件会缩小为托盘，右键托盘可手动连接、注销或返回设置", -1, 10, 258, 340, 12, SS_LEFT

    CONTROL         "⚠ 清除所有数据并退出", IDC_CLEAR_DATA, "Button", BS_OWNERDRAW | WS_TABSTOP, 10, 276, 122, 19
    PUSHBUTTON      "关闭", IDCANCEL, 140, 276, 100, 19
    DEFPUSHBUTTON   "保存", IDOK, 250, 276, 100, 19
END
